{
  "name": "artifact",
  "version": "0.4.0",
  "private": true,
  "description": "Artifact — a private AI workspace for research, reasoning, and source-backed work. Local agents run on your device; reviewed AgentApps add web research and document search; permissions stay visible while active.",
  "main": "out/main/index.js",
  "files": [
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "app:build": "electron-vite build",
    "app:preview": "electron-vite preview",
    "pack": "npm run app:build && electron-builder --dir",
    "dist": "npm run app:build && electron-builder",
    "release": "npm run dist && bash release.sh",
    "web:dev": "VITE_WSS_URL=ws://127.0.0.1:8787 vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts"
  },
  "dependencies": {
    "reasoning.run": "^0.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "reasoning",
    "private-reasoner",
    "deep-research",
    "grounded-reasoning",
    "multi-agent",
    "agents",
    "rag",
    "local-llm",
    "offline",
    "on-device",
    "gpu",
    "llama.cpp",
    "desktop",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloyal-ai/artifact.git"
  },
  "license": "UNLICENSED"
}
